{
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.log.*"
    ]
  },
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "rewrites": [
      {
        "source": "/news/**",
        "destination": "/news/_template/index.html"
      },
      {
        "source": "/admin/edit/**",
        "destination": "/admin/edit/_template/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}